#!/usr/bin/env bash
set -euo pipefail

app="${1:-}"

case "$app" in
  kodi)
    nohup flatpak run tv.kodi.Kodi >/dev/null 2>&1 &
    ;;
  plexamp)
    if flatpak info com.plexamp.Plexamp >/dev/null 2>&1; then
      nohup flatpak run com.plexamp.Plexamp >/dev/null 2>&1 &
    else
      nohup "$HOME/bin/plexamp-wine" >/dev/null 2>&1 &
    fi
    ;;
  moonlight)
    nohup flatpak run com.moonlight_stream.Moonlight >/dev/null 2>&1 &
    ;;
  qobuz)
    nohup "$HOME/bin/qobuz-wine" >/dev/null 2>&1 &
    ;;
  *)
    echo "Usage: htpc-launch {kodi|plexamp|moonlight|qobuz}"
    exit 1
    ;;
esac
