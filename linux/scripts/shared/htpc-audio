#!/usr/bin/env bash
set -euo pipefail

CARD="alsa_card.pci-0000_00_1f.3"  # from \`pactl list cards short\`
READY_TIMEOUT="\${HTPC_AUDIO_READY_TIMEOUT:-15}"
POLL_INTERVAL=0.2
PROFILE_TIMEOUT=10
PACTL_COMMAND_TIMEOUT="\${HTPC_AUDIO_PACTL_TIMEOUT:-3}"
TRANSITION_SINK="htpc_audio_transition"

mode="\${1:-}"
expected_profile=""
expected_sink=""
old_profile=""
old_sink=""
moved_inputs=()

usage() {
  cat <<EOF
Usage: htpc-audio MODE

MODE:
  analog-stereo      - Onboard analog stereo (PC speakers / headphones)
  hdmi-stereo        - HDMI stereo (2.0 PCM) to DENON AVR
  surround51-hdmi    - HDMI surround 5.1 PCM to DENON AVR
  surround71-hdmi    - HDMI surround 7.1 PCM to DENON AVR

EOF
  exit 1
}

# Keep the flock descriptor in the parent shell only. pactl is always bounded,
# and closing FD 9 prevents an orphaned child from retaining the transition lock.
pactl_with_timeout() {
  local duration="$1"
  shift
  local status=0
  if ( exec 9>&-; timeout --signal=TERM --kill-after=1s "\${duration}s" pactl "$@" ); then
    return 0
  else
    status=$?
    if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
      echo "Timed out after \${duration}s: pactl $*" >&2
    fi
    return "$status"
  fi
}

pactl_cmd() {
  pactl_with_timeout "$PACTL_COMMAND_TIMEOUT" "$@"
}

active_profile() {
  local cards
  cards="$(pactl_cmd list cards 2>/dev/null)" || return 1
  local profile
  profile="$(printf '%s\n' "$cards" | awk -v card="$CARD" '
    /^Card #[0-9]+/ { in_card=0 }
    /^[[:space:]]*Name: / { in_card=($2 == card) }
    in_card && /^[[:space:]]*Active Profile: / {
      sub(/^[[:space:]]*Active Profile: /, "")
      print
      exit
    }
  ')"
  [[ -n "$profile" ]] || return 1
  printf '%s\n' "$profile"
}

sink_exists() {
  local sinks
  sinks="$(pactl_cmd list short sinks 2>/dev/null)" || return 2
  printf '%s\n' "$sinks" |
    awk -v sink="$1" '$2 == sink { found=1 } END { exit !found }'
}

sink_index_from_list() {
  awk -v sink="$1" '$2 == sink { print $1; exit }'
}

wait_for_sink() {
  local sink="$1"
  local deadline=$((SECONDS + READY_TIMEOUT))
  local status
  while (( SECONDS < deadline )); do
    if sink_exists "$sink"; then
      return 0
    else
      status=$?
      [[ "$status" -eq 1 ]] || return 1
    fi
    sleep "$POLL_INTERVAL"
  done
  return 1
}

wait_for_profile() {
  local profile="$1"
  local sink="$2"
  local current_profile
  local status
  local deadline=$((SECONDS + READY_TIMEOUT))

  while (( SECONDS < deadline )); do
    if ! current_profile="$(active_profile 2>/dev/null)"; then
      return 1
    fi
    if [[ "$current_profile" == "$profile" ]]; then
      if [[ -z "$sink" ]]; then
        return 0
      fi
      if sink_exists "$sink"; then
        return 0
      else
        status=$?
        [[ "$status" -eq 1 ]] || return 1
      fi
    fi
    sleep "$POLL_INTERVAL"
  done
  return 1
}

sink_input_exists() {
  local current_inputs
  if ! current_inputs="$(pactl_cmd list short sink-inputs 2>/dev/null)"; then
    return 2
  fi
  printf '%s\n' "$current_inputs" |
    awk -v input="$1" '$1 == input { found=1 } END { exit !found }'
}

move_inputs() {
  local target_sink="$1"
  local input_id
  local failed=0

  for input_id in "\${moved_inputs[@]}"; do
    if sink_input_exists "$input_id"; then
      if ! pactl_cmd move-sink-input "$input_id" "$target_sink"; then
        echo "Failed to move active audio stream $input_id to '$target_sink'." >&2
        failed=1
      fi
    else
      local status=$?
      if [[ "$status" -ne 1 ]]; then
        echo "Could not verify whether audio stream $input_id still exists." >&2
        failed=1
      fi
    fi
  done

  return "$failed"
}

restore_old_audio() {
  local current_profile
  current_profile="$(active_profile 2>/dev/null || true)"

  if [[ -n "$old_profile" && "$current_profile" != "$old_profile" ]]; then
    pactl_with_timeout "$PROFILE_TIMEOUT" set-card-profile "$CARD" "$old_profile" || true
  fi

  if [[ -n "$old_profile" && -n "$old_sink" ]] &&
    wait_for_profile "$old_profile" "$old_sink"; then
    move_inputs "$old_sink" || true
  else
    echo "Could not restore the original audio profile/sink. Preserved streams remain on '$TRANSITION_SINK'." >&2
  fi
}

case "$mode" in
  analog-stereo)
    expected_profile="output:analog-stereo"
    expected_sink="alsa_output.pci-0000_00_1f.3.analog-stereo"
    ;;
  hdmi-stereo)
    expected_profile="output:hdmi-stereo"
    expected_sink="alsa_output.pci-0000_00_1f.3.hdmi-stereo"
    ;;
  surround51-hdmi)
    expected_profile="output:hdmi-surround"
    expected_sink="alsa_output.pci-0000_00_1f.3.hdmi-surround"
    ;;
  surround71-hdmi)
    expected_profile="output:hdmi-surround71"
    expected_sink="alsa_output.pci-0000_00_1f.3.hdmi-surround71"
    ;;
  *)
    usage
    ;;
esac

# Serialize profile changes. A later request must not race an in-progress
# PipeWire profile recreation.
LOCK_DIR="\${XDG_RUNTIME_DIR:-/tmp}"
[[ -d "$LOCK_DIR" ]] || LOCK_DIR="/tmp"
umask 077
exec 9>"$LOCK_DIR/htpc-audio-\${UID}.lock"
flock -w 20 9 || {
  echo "Timed out waiting for another audio-mode change to finish." >&2
  exit 1
}

old_profile="$(active_profile)"
case "$old_profile" in
  output:analog-stereo) old_sink="alsa_output.pci-0000_00_1f.3.analog-stereo" ;;
  output:hdmi-stereo) old_sink="alsa_output.pci-0000_00_1f.3.hdmi-stereo" ;;
  output:hdmi-surround) old_sink="alsa_output.pci-0000_00_1f.3.hdmi-surround" ;;
  output:hdmi-surround71) old_sink="alsa_output.pci-0000_00_1f.3.hdmi-surround71" ;;
esac

sinks_output="$(pactl_cmd list short sinks)" || {
  echo "Could not inspect audio sinks; profile was not changed." >&2
  exit 1
}
old_sink_id=""
if [[ -n "$old_sink" ]]; then
  old_sink_id="$(printf '%s\n' "$sinks_output" | sink_index_from_list "$old_sink")"
fi
transition_sink_id="$(printf '%s\n' "$sinks_output" | sink_index_from_list "$TRANSITION_SINK")"
legacy_transition_ids="$(printf '%s\n' "$sinks_output" | awk '$2 ~ /^htpc_audio_transition_[0-9]+$/ { printf "%s ", $1 }')"

# Include streams on the current HDMI sink, the persistent transition sink,
# and any uniquely-named transition sinks left behind by the previous version.
tracked_sink_ids="$old_sink_id $transition_sink_id $legacy_transition_ids"
sink_inputs_output=""
active_inputs=()
declare -A input_source_sinks=()
if [[ -n "\${tracked_sink_ids//[[:space:]]/}" ]]; then
  sink_inputs_output="$(pactl_cmd list short sink-inputs)" || {
    echo "Could not inspect active audio streams; profile was not changed." >&2
    exit 1
  }
  while read -r input_id input_sink_id; do
    [[ -n "$input_id" && -n "$input_sink_id" ]] || continue
    if [[ " $tracked_sink_ids " == *" $input_sink_id "* ]]; then
      active_inputs+=("$input_id")
      input_source_sinks["$input_id"]="$input_sink_id"
    fi
  done < <(printf '%s\n' "$sink_inputs_output" | awk '{ print $1, $2 }')
fi

# Same-profile selections are normally no-ops. First recover any stream left
# parked on a transition sink by an interrupted/older invocation.
if [[ "$old_profile" == "$expected_profile" ]] && sink_exists "$expected_sink"; then
  moved_inputs=()
  for input_id in "\${active_inputs[@]}"; do
    if [[ "\${input_source_sinks[$input_id]}" != "$old_sink_id" ]]; then
      moved_inputs+=("$input_id")
    fi
  done
  if (("\${#moved_inputs[@]}" > 0)) && ! move_inputs "$expected_sink"; then
    echo "Could not recover audio streams parked on the transition sink." >&2
    exit 1
  fi
  exit 0
fi

# If there are streams to preserve, create the persistent transition sink once.
# It is intentionally left loaded: unloading/reloading a Pulse module on every
# mode change adds another PipeWire graph teardown and can itself stall.
if (("\${#active_inputs[@]}" > 0)); then
  if [[ -z "$transition_sink_id" ]]; then
    pactl_cmd load-module module-null-sink \
      sink_name="$TRANSITION_SINK" channels=8 \
      channel_map=front-left,front-right,front-center,lfe,rear-left,rear-right,side-left,side-right \
      sink_properties=device.description=HTPC_Audio_Transition >/dev/null || {
      echo "Could not create the persistent transition sink; profile was not changed." >&2
      exit 1
    }
    if ! wait_for_sink "$TRANSITION_SINK"; then
      echo "Persistent transition sink '$TRANSITION_SINK' did not appear; profile was not changed." >&2
      exit 1
    fi
    transition_sinks_output="$(pactl_cmd list short sinks)" || {
      echo "Could not verify the persistent transition sink; preserving streams on it." >&2
      restore_old_audio
      exit 1
    }
    transition_sink_id="$(printf '%s\n' "$transition_sinks_output" | sink_index_from_list "$TRANSITION_SINK")"
  fi

  moved_inputs=("\${active_inputs[@]}")
  for input_id in "\${active_inputs[@]}"; do
    if [[ "\${input_source_sinks[$input_id]}" == "$transition_sink_id" ]]; then
      continue
    fi
    if sink_input_exists "$input_id"; then
      if ! pactl_cmd move-sink-input "$input_id" "$TRANSITION_SINK"; then
        echo "Could not safely park active audio stream $input_id; restoring the original streams." >&2
        restore_old_audio
        exit 1
      fi
    else
      input_status=$?
      if [[ "$input_status" -ne 1 ]]; then
        echo "Could not verify active audio stream $input_id; profile was not changed." >&2
        restore_old_audio
        exit 1
      fi
    fi
  done
fi

if ! pactl_with_timeout "$PROFILE_TIMEOUT" set-card-profile "$CARD" "$expected_profile"; then
  echo "Failed to set audio profile '$expected_profile'." >&2
  restore_old_audio
  exit 1
fi

if ! wait_for_profile "$expected_profile" "$expected_sink"; then
  current_profile="$(active_profile 2>/dev/null || true)"
  echo "Timed out waiting for sink '$expected_sink' (active profile: '$current_profile', expected: '$expected_profile')." >&2
  restore_old_audio
  exit 1
fi

if ! move_inputs "$expected_sink"; then
  echo "The new audio sink is ready, but one or more streams could not be reattached. Attempting to restore the previous profile and stream routing." >&2
  restore_old_audio
  exit 1
fi

exit 0
