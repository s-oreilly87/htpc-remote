 Q_GLOBAL_STATIC(EventData, data)
 
+static QPointF logicalPosition(FrameBuffer *frameBuffer, int x, int y)
+{
+    const QSize frameSize(frameBuffer->width(), frameBuffer->height());
+    const QSize logicalSize = frameBuffer->customProperty(QStringLiteral("stream_logical_size")).toSize();
+    if (frameSize.isEmpty() || logicalSize.isEmpty()) {
+        return QPointF(x, y);
+    }
+
+    return QPointF(static_cast<qreal>(x) * logicalSize.width() / frameSize.width(),
+                   static_cast<qreal>(y) * logicalSize.height() / frameSize.height());
+}
